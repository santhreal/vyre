[package]
name = "{{crate_name}}"
version = "0.1.0"
edition = "2021"
rust-version = "1.85"
license = "MIT OR Apache-2.0"
description = "Community Cat-A op dialect for vyre-libs"
repository = "https://github.com/{{gh_org}}/{{crate_name}}"
readme = "README.md"
keywords = ["gpu", "vyre", "cat-a"]
categories = ["algorithms"]

[dependencies]
vyre = "0.8.0"
# The scaffold's typed builder uses `check_tensors`, `check_same_shape`,
# `checked_element_count` and `BuildOptions`, which the `builder` feature
# publishes. `default-features = false` keeps the dialect closure off.
vyre-libs = { version = "0.8.0", default-features = false, features = ["builder"] }
vyre-foundation = "0.8.0"
vyre-spec = "0.8.0"
thiserror = "2"
inventory = "0.3"

[dev-dependencies]
vyre-reference = "0.8.0"

[package.metadata.docs.rs]
all-features = true
rustdoc-args = ["--cfg", "docsrs"]

[workspace]

[lints.rust]
unsafe_code = "forbid"
missing_docs = "warn"
